#!/bin/sh
[ -e '/etc/config/dhcp' ] || exit 0

. /lib/functions/system.sh


set_dhcp()
{
    local device=$1

    case $device in
        THG6500-TAX2)
            uci batch << 'EOF'
                set dhcp.lan.dhcpv4='server'
                set dhcp.lan.dhcpv6='server'
                set dhcp.lan.ra='server'
                delete dhcp.lan.ra_flags
                add_list dhcp.lan.ra_flags='managed'
                add_list dhcp.lan.ra_flags='other'
EOF
            ;;
        *)
            uci batch << 'EOF'
                set dhcp.lan.dhcpv4='disabled'
                set dhcp.lan.dhcpv6='disabled'
                set dhcp.lan.ra='disabled'
                delete dhcp.lan.ra_flags
                add_list dhcp.lan.ra_flags='none'
EOF
            ;;
    esac
}


main()
{
    local device=$(board_name)

    `set_dhcp "$device"`
}

main
